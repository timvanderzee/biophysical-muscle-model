subplot(211)
plot(t1, F, tap, Fap)
box off
legend('Discretized', 'Approximated', 'location','best')
title('Force')

subplot(212)
plot(t1(1:end-1), diff(t1),tap(1:end-1), diff(tap))
box off
title('Time step ode15s')
ylabel('dt (s)')

