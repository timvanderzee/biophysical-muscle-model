% id = N;
% % id = 190;
% 
% dy = fiber_dynamics_explicit_length(sol.x(id), sol.y(:,id), parms)
% 
% soln = sol.y(:,id) + dy * .001
% fiber_dynamics_explicit_length(sol.x(id), soln, parms)

